{
  "manifest_version": 3,
  "name": "VAHAN RPA Assistant",
  "version": "0.1.0",
  "description": "Fills VAHAN report filters and exports Excel after manual CAPTCHA completion.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://analytics.parivahan.gov.in/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "VAHAN RPA Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://analytics.parivahan.gov.in/analytics/vahanpublicreport*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
