{
  "manifest_version": 3,
  "name": "VAHAN RPA Assistant",
  "version": "1.0.0",
  "description": "Tool tự động trích xuất báo cáo VAHAN RPA (Attended Automation Demo)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.parivahan.gov.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.parivahan.gov.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VAHAN RPA Assistant"
  }
}
